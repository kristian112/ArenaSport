@page
@model LoginModel

<div class="container d-flex justify-content-center align-items-center" style="min-height:70vh;">
    <div class="card p-4 shadow-lg rounded-4 border-0" style="width:380px;">

        <h3 class="fw-bold text-center text-danger mb-3">Вход</h3>

        <form method="post">
            <div class="mb-2">
                <input asp-for="Input.Email" class="form-control rounded-3" placeholder="Имейл" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="mb-2">
                <input asp-for="Input.Password" class="form-control rounded-3" placeholder="Парола" type="password" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-danger w-100 mt-2 rounded-3">Влез</button>
        </form>

        <p class="text-center mt-3 small">
            Нямаш профил? →
            <a class="text-danger fw-semibold" asp-area="Identity" asp-page="/Account/Register">Регистрирай се</a>
        </p>

    </div>
</div>
