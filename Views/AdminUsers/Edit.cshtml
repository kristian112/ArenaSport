@model ArenaSportProj.Models.ApplicationUser

<div class="container py-5">
    <h3 class="fw-bold text-danger mb-3">Редактиране на потребител</h3>

    <form method="post" class="card p-4 shadow rounded-4 border-0">
        <div class="mb-2">
            <label class="form-label fw-semibold">Имейл</label>
            <input asp-for="Email" class="form-control rounded-3" />
        </div>

        <div class="mb-2">
            <label class="form-label fw-semibold">Телефон</label>
            <input asp-for="PhoneNumber" class="form-control rounded-3" />
        </div>

        <button type="submit" class="btn btn-danger mt-2 rounded-3">Запази</button>
        <a asp-action="Index" class="btn btn-dark text-danger mt-2 rounded-3">Назад</a>
    </form>
</div>
