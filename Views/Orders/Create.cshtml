@model ArenaSportProj.Models.Order
@using ArenaSportProj.Models

<div class="container py-5">
    <h3 class="fw-bold text-danger mb-3">Добавяне на поръчка</h3>

    <form method="post" class="card p-4 shadow rounded-4 border-0">
        <input asp-for="UserId" class="form-control mb-2 rounded-3" placeholder="Потребител (UserID)" />
        <input asp-for="Address" class="form-control mb-2 rounded-3" placeholder="Адрес" />
        <input asp-for="PhoneNumber" class="form-control mb-2 rounded-3" placeholder="Телефон" />
        <button type="submit" class="btn btn-danger mt-2 rounded-3">Запази</button>
    </form>
</div>
