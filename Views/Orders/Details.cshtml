@model ArenaSportProj.Models.Order

<div class="container py-5">
    <h3 class="fw-bold text-danger mb-3">Поръчка #@Model.Id</h3>

    <div class="card p-4 shadow-sm rounded-4 border-0 mb-3">
        <p><strong>Потребител:</strong> @Model.UserId</p>
        <p><strong>Дата:</strong> @Model.CreatedOn.ToLocalTime()</p>
        <p><strong>Адрес:</strong> @Model.Address</p>
        <p><strong>Телефон:</strong> @Model.PhoneNumber</p>
        <p><strong>Плащане:</strong> @Model.PaymentMethod</p>
        <p class="fw-bold fs-5">Обща сума: @Model.TotalPrice лв.</p>
    </div>

    <h5 class="fw-bold">Стоки в поръчката:</h5>
    <ul class="list-group">
        @foreach (var i in Model.Items)
        {
            <li class="list-group-item d-flex justify-content-between">
                <span>@i.Product.Name (Марка: @i.Product.Brand) × @i.Quantity</span>
                <span>@i.UnitPrice лв.</span>
            </li>
        }
    </ul>

    <a asp-action="Index" class="btn btn-dark mt-3 text-danger">Назад</a>
</div>
