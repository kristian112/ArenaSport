@model ArenaSportProj.Models.Product
@using ArenaSportProj.Models

<div class="container py-5">
    <h3 class="fw-bold text-danger mb-3 text-center">Детайли за стока</h3>

    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card p-4 shadow rounded-4 border-0 text-center">
                <img src="@Model.ImageUrl" class="img-fluid rounded-4 mb-3" style="max-height:240px; object-fit:cover;"
                     onerror="this.src='https://placehold.co/240x240?text=Няма+снимка';" />

                <h4 class="fw-bold">@Model.Name</h4>
                <p class="text-muted">@Model.Brand</p>
                <p class="fw-semibold fs-5">@Model.Price лв.</p>

                @if (Model.Category != null)
                {
                    <p class="badge bg-danger text-white px-3 py-2 rounded-3">@Model.Category.Name</p>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="mt-3 text-start">@Model.Description</p>
                }
                else
                {
                    <p class="text-muted mt-3">Няма добавено описание.</p>
                }


                <div class="mt-3">
                    <button class="btn btn-dark text-danger rounded-3" onclick="history.back()">Назад</button>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-danger rounded-3">Редактирай</a>
                </div>
            </div>
        </div>
    </div>
</div>
