@model ArenaSportProj.Models.Product
@using ArenaSportProj.Models

<div class="container py-5">
    <h3 class="fw-bold text-danger mb-3">Редактиране на стока</h3>

    <form method="post" class="card p-4 shadow rounded-4 border-0">
        <input asp-for="Name" class="form-control mb-2 rounded-3" />
        <input asp-for="Brand" class="form-control mb-2 rounded-3" />
        <input asp-for="Price" class="form-control mb-2 rounded-3" />

        <select asp-for="CategoryId" class="form-select mb-2 rounded-3">
            @foreach (var c in ViewBag.Categories as List<Category>)
            {
                if (Model.CategoryId == c.Id)
                {
                    <option value="@c.Id" selected>@c.Name</option>
                }
                else
                {
                    <option value="@c.Id">@c.Name</option>
                }
            }
        </select>

        <div class="mb-2">
            <input asp-for="ImageUrl" class="form-control rounded-3" placeholder="Линк към снимка" />
            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
        </div>

        <div class="mb-2">
            <textarea asp-for="Description" class="form-control rounded-3" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>


        <button type="submit" class="btn btn-danger mt-2 rounded-3">Запази</button>
    </form>
</div>
