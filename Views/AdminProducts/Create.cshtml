@model ArenaSportProj.Models.Product

<div class="container py-5">
    <h3 class="fw-bold text-danger mb-3">Добавяне на стока</h3>

    <form method="post" class="card p-4 shadow rounded-4 border-0">
        <input asp-for="Name" class="form-control mb-2 rounded-3" placeholder="Име" />
        <input asp-for="Brand" class="form-control mb-2 rounded-3" placeholder="Марка" />
        <input asp-for="Price" class="form-control mb-2 rounded-3" placeholder="Цена" />

        <select asp-for="CategoryId" class="form-select mb-2 rounded-3">
            <option value="">Избери спорт</option>

            @if (ViewBag.Categories != null)
            {
                foreach (var c in ViewBag.Categories)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            }
        </select>

        <div class="mb-2">
            <input asp-for="ImageUrl" class="form-control rounded-3" placeholder="Линк към снимка" />
            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
        </div>

        <div class="mb-2">
            <textarea asp-for="Description" class="form-control rounded-3" rows="4" placeholder="Описание на стоката"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-danger mt-2 rounded-3">Запази</button>
    </form>
</div>
