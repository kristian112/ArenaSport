@model ArenaSportProj.Models.Product

<div class="container py-4">
    <div class="row">
        <div class="col-md-5"><img src="@Model.ImageUrl" class="img-fluid rounded shadow"></div>
        <div class="col-md-7">
            <h2 class="fw-bold">@Model.Name</h2>
            <p class="text-muted">@Model.Category.Name</p>
            <p>Brand: @Model.Brand</p>
            <p class="fw-bold fs-3 text-danger">@Model.Price лв</p>
            <p>@Model.Description</p>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a href="/Cart/Add?productId=@Model.Id" class="btn btn-danger btn-lg fw-bold">Добави в количка</a>
            }
        </div>
    </div>
</div>
