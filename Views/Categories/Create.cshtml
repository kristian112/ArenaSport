@model ArenaSportProj.Models.Category

<div class="container py-5">
    <h3 class="fw-bold text-danger mb-3">Добавяне на категория</h3>

    <form method="post" class="card p-4 shadow rounded-4 border-0">
        <input asp-for="Name" class="form-control mb-2 rounded-3" placeholder="Име на категорията" />
        <button type="submit" class="btn btn-danger rounded-3 mt-2">Запази</button>
    </form>
</div>
